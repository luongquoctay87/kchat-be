SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8864

DB_URL=jdbc:postgresql://localhost:5432/kchat
DB_USER=admin
DB_PASSWORD=123

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123

JWT_ACCESS_SECRET=dev-kchat-access-secret-change-me-32b!!
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=30

# S3 — required (avatars + chat uploads). ECS staging: task role, omit ACCESS/SECRET.
KCHAT_S3_BUCKET=
KCHAT_S3_REGION=ap-southeast-1
# KCHAT_S3_ENDPOINT=http://localhost:9000
KCHAT_S3_ACCESS_KEY=
KCHAT_S3_SECRET_KEY=

# WebRTC ICE / TURN (production: set your own TURN; leave blank in local — dev profile uses openrelay)
# KCHAT_WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# KCHAT_WEBRTC_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# Static creds:
# KCHAT_WEBRTC_TURN_USERNAME=kchat
# KCHAT_WEBRTC_TURN_CREDENTIAL=change-me
# Or coturn REST API shared secret (ephemeral username/password per user):
# KCHAT_WEBRTC_TURN_SHARED_SECRET=coturn-static-auth-secret
# KCHAT_WEBRTC_TURN_TTL_SECONDS=86400
# KCHAT_WEBRTC_ALLOW_DEV_OPENRELAY=false

# Password / registration OTP email
# Copy to .env and set MAIL_ENABLED=true + real SMTP_* (never commit secrets).
KCHAT_PASSWORD_RESET_MAIL_ENABLED=false
KCHAT_MAIL_APP_NAME=k-chat
KCHAT_MAIL_FROM_NAME=k-chat
KCHAT_MAIL_COMPANY_NAME=k-chat
KCHAT_SUPPORT_EMAIL=support@example.com
# Gmail: port 587 + App Password (not account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# FCM push (local dev only — staging uses Terraform + Secrets Manager)
# KCHAT_FCM_ENABLED=true
# KCHAT_FCM_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# --- Staging / prod (SPRING_PROFILES_ACTIVE=prod) ---
# Required, no bundled defaults. Do not reuse the JWT / webhook secrets above.
# Apply docs/sql/kchat-schema.sql on an empty DB. Do not apply kchat-seed.sql.
# ECS: TOMCAT_INTERNAL_PROXIES is set by Terraform (VPC CIDR). Local leave unset.
# KCHAT_OPS_ALERTS_WEBHOOK_SECRET=
# KCHAT_S3_BUCKET=
# KCHAT_PASSWORD_RESET_MAIL_ENABLED=true
# TOMCAT_INTERNAL_PROXIES=10\.20\.\d{1,3}\.\d{1,3}
